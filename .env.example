# ==============================================================================
# 1. DATABASE & DOCKER (PostgreSQL 16)
# ==============================================================================
POSTGRES_DB=smart_event_db
POSTGRES_USER=smartevent
POSTGRES_PASSWORD=change_me_local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smart_event_db
SPRING_DATASOURCE_USERNAME=smartevent
SPRING_DATASOURCE_PASSWORD=change_me_local

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ==============================================================================
# 2. JWT SECURITY (Identity Module)
# ==============================================================================
# Tạo 32 byte ngẫu nhiên, biểu diễn Base64; Base64 không phải mã hóa bảo mật.
JWT_SECRET=
# Thời gian sống Access Token: 900.000 ms = 15 phút
JWT_ACCESS_EXPIRATION=900000
# Thời gian sống Refresh Token: 604.800.000 ms = 7 ngày
JWT_REFRESH_EXPIRATION=604800000

# ==============================================================================
# 3. MESSAGE BROKER (RabbitMQ)
# ==============================================================================
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=smartevent
SPRING_RABBITMQ_PASSWORD=change_me_local

# ==============================================================================
# 4. OBJECT STORAGE (MinIO)
# ==============================================================================
APP_MINIO_ENDPOINT=http://localhost:9000
APP_MINIO_ACCESS_KEY=smartevent
APP_MINIO_SECRET_KEY=change_me_local_minio
APP_MINIO_BUCKET=smart-event-bucket

# ==============================================================================
# 5. CỔNG THANH TOÁN VNPAY (Sandbox)
# ==============================================================================
# Điền mã vnp_TmnCode và vnp_HashSecret trong email bạn vừa nhận
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay/ipn

# Frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SMTP: điền tài khoản gửi thật để gửi vé và hóa đơn.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_ENABLED=true

# Số consumer email; tăng từ từ theo giới hạn SMTP.
APP_NOTIFICATION_CONSUMERS=1
APP_NOTIFICATION_MAX_CONSUMERS=2
APP_NOTIFICATION_PREFETCH=5

# Chỉ bật trang Swagger công khai trong môi trường local/demo.
APP_DOCS_PUBLIC=true
